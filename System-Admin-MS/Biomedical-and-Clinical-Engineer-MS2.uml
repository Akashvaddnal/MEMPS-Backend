              <ownedParameter xmi:id="_hmUyWXLIEfC-BOCJpGoLHQ" type="_hkNScXLIEfC-BOCJpGoLHQ" direction="return"/>
              <language>java</language>
              <body>return departmentService.getById(id)&#xD;
             .map(ResponseEntity::ok)&#xD;
             .orElse(ResponseEntity.notFound().build());&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmWAcHLIEfC-BOCJpGoLHQ" name="createDepartment" specification="_hkSK9nLIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmWAcXLIEfC-BOCJpGoLHQ" name="department" type="_hLepYHLIEfC-BOCJpGoLHQ"/>
              <ownedParameter xmi:id="_hmWAcnLIEfC-BOCJpGoLHQ" type="_hkNScXLIEfC-BOCJpGoLHQ" direction="return"/>
              <language>java</language>
              <body>Department created = departmentService.createDepartment(department);&#xD;
     return ResponseEntity.status(HttpStatus.CREATED).body(created);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmWAc3LIEfC-BOCJpGoLHQ" name="updateDepartment" specification="_hkTZE3LIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmWAdHLIEfC-BOCJpGoLHQ" name="id">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_hmWAdXLIEfC-BOCJpGoLHQ" name="department" type="_hLepYHLIEfC-BOCJpGoLHQ"/>
              <ownedParameter xmi:id="_hmWAdnLIEfC-BOCJpGoLHQ" type="_hkNScXLIEfC-BOCJpGoLHQ" direction="return"/>
              <language>java</language>
              <body>try {&#xD;
         Department updated = departmentService.updateDepartment(id, department);&#xD;
         return ResponseEntity.ok(updated);&#xD;
     } catch (NoSuchElementException nse) {&#xD;
         return ResponseEntity.notFound().build();&#xD;
     }&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmWAd3LIEfC-BOCJpGoLHQ" name="deleteDepartment" specification="_hKPTQ3LIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmWAeHLIEfC-BOCJpGoLHQ" name="id">
