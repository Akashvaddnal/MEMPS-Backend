              <language>java</language>
              <body>List&lt;Department> result = departmentService.searchDepartments(name, location);&#xD;
     return ResponseEntity.ok(result);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmUyV3LIEfC-BOCJpGoLHQ" name="getDepartmentById" specification="_hKOFIHLIEfC-BOCJpGoLHQ">
