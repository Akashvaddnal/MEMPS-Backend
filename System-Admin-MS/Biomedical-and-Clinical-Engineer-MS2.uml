            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmo7YHLIEfC-BOCJpGoLHQ" name="setUp" specification="_hN5EMnLIEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>MockitoAnnotations.openMocks(this);&#xD;
     mockMvc = MockMvcBuilders.standaloneSetup(controller).build();&#xD;
&#xD;
     usage = new EquipmentUsage();&#xD;
     usage.setId(&quot;1&quot;);&#xD;
     usage.setEquipmentId(&quot;equip1&quot;);&#xD;
     usage.setUsedBy(&quot;user1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmo7YXLIEfC-BOCJpGoLHQ" name="create" specification="_hN5rQ3LIEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(service.save(any(EquipmentUsage.class))).thenReturn(usage);&#xD;
&#xD;
     mockMvc.perform(post(&quot;/api/equipment-usage&quot;)&#xD;
                     .contentType(MediaType.APPLICATION_JSON)&#xD;
                     .content(&quot;{\&quot;equipmentId\&quot;:\&quot;equip1\&quot;,\&quot;usedBy\&quot;:\&quot;user1\&quot;}&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$.usedBy&quot;).value(&quot;user1&quot;));&#xD;
&#xD;
     verify(service, times(1)).save(any(EquipmentUsage.class));&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmo7YnLIEfC-BOCJpGoLHQ" name="getById" specification="_hN5rR3LIEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(service.findById(&quot;1&quot;)).thenReturn(java.util.Optional.of(usage));&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/equipment-usage/1&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$.equipmentId&quot;).value(&quot;equip1&quot;));&#xD;
&#xD;
     verify(service, times(1)).findById(&quot;1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmo7Y3LIEfC-BOCJpGoLHQ" name="getAll" specification="_hN65Y3LIEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(service.findAll()).thenReturn(Arrays.asList(usage));&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/equipment-usage&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$[0].equipmentId&quot;).value(&quot;equip1&quot;));&#xD;
&#xD;
     verify(service, times(1)).findAll();&#xD;
 </body>
            </ownedBehavior>
