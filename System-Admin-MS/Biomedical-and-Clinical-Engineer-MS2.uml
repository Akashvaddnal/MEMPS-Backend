            <ownedAttribute xmi:id="_hluVYnLIEfC-BOCJpGoLHQ" name="departmentService" visibility="private" isLeaf="true" type="_hMRTkHLIEfC-BOCJpGoLHQ" isReadOnly="true" association="_hnJRsXLIEfC-BOCJpGoLHQ"/>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmUyUHLIEfC-BOCJpGoLHQ" name="DepartmentController" specification="_hkSK8HLIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmUyUXLIEfC-BOCJpGoLHQ" name="departmentService" type="_hMRTkHLIEfC-BOCJpGoLHQ"/>
