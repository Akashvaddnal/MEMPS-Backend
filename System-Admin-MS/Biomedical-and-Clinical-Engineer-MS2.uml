            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmULQXLIEfC-BOCJpGoLHQ" name="customConversions" specification="_hKApwnLIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmULQnLIEfC-BOCJpGoLHQ" type="_hkF9sXLIEfC-BOCJpGoLHQ" direction="return"/>
              <language>java</language>
              <body>Converter&lt;String, LocalDateTime> stringToLocalDateTime = new Converter&lt;String, LocalDateTime>() {&#xD;
         @Override&#xD;
         public LocalDateTime convert(String source) {&#xD;
             if (source == null || source.isEmpty()) {&#xD;
                 return null;&#xD;
             }&#xD;
             return LocalDateTime.parse(source);&#xD;
         }&#xD;
     };&#xD;
     &#xD;
     return new MongoCustomConversions(Arrays.asList(stringToLocalDateTime));&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmULQ3LIEfC-BOCJpGoLHQ" name="validator" specification="_hKCe8HLIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmULRHLIEfC-BOCJpGoLHQ" type="_hkGkwXLIEfC-BOCJpGoLHQ" direction="return"/>
              <language>java</language>
              <body>return new LocalValidatorFactoryBean();&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmULRXLIEfC-BOCJpGoLHQ" name="validatingMongoEventListener" specification="_hlQbUHLIEfC-BOCJpGoLHQ">
