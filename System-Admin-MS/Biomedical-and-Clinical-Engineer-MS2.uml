&#xD;
     mockMvc.perform(get(&quot;/api/equipment-usage/unitid/unit1&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$[0].equipmentId&quot;).value(&quot;equip1&quot;));&#xD;
&#xD;
     verify(service, times(1)).findByUnitId(&quot;unit1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmo7ZnLIEfC-BOCJpGoLHQ" name="getByUsedBy" specification="_hN8uknLIEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(service.findByUsedBy(&quot;user1&quot;)).thenReturn(Arrays.asList(usage));&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/equipment-usage/usedby/user1&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$[0].usedBy&quot;).value(&quot;user1&quot;));&#xD;
&#xD;
     verify(service, times(1)).findByUsedBy(&quot;user1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmo7Z3LIEfC-BOCJpGoLHQ" name="updateEquipmentUsage" specification="_hN9VonLIEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(service.updateEquipmentUsage(anyString(), any(EquipmentUsage.class))).thenReturn(usage);&#xD;
&#xD;
     mockMvc.perform(put(&quot;/api/equipment-usage/equipment-usage/1&quot;)&#xD;
                     .contentType(MediaType.APPLICATION_JSON)&#xD;
                     .content(&quot;{\&quot;equipmentId\&quot;:\&quot;equip1\&quot;,\&quot;usedBy\&quot;:\&quot;user1\&quot;}&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$.usedBy&quot;).value(&quot;user1&quot;));&#xD;
