            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmUyU3LIEfC-BOCJpGoLHQ" name="getAllDepartments" specification="_hKJzsHLIEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_hmUyVHLIEfC-BOCJpGoLHQ" name="name">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_hmUyVXLIEfC-BOCJpGoLHQ" name="location">
