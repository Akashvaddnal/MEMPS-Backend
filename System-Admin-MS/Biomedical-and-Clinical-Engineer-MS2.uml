                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
                <ownedParameter xmi:id="_hmfxeXLIEfC-BOCJpGoLHQ" type="_hkV1UHLIEfC-BOCJpGoLHQ" direction="return"/>
                <language>java</language>
                <body>return departmentRepository.findById(id);&#xD;
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmgYgHLIEfC-BOCJpGoLHQ" name="createDepartment" specification="_hk1kk3LIEfC-BOCJpGoLHQ">
                <ownedParameter xmi:id="_hmgYgXLIEfC-BOCJpGoLHQ" name="department" type="_hLepYHLIEfC-BOCJpGoLHQ"/>
                <ownedParameter xmi:id="_hmgYgnLIEfC-BOCJpGoLHQ" type="_hLepYHLIEfC-BOCJpGoLHQ" direction="return"/>
                <language>java</language>
                <body>department.setCreatedAt(Instant.now());&#xD;
     department.setUpdatedAt(Instant.now());&#xD;
     if (department.getEquipmentInventory() == null) {&#xD;
         department.setEquipmentInventory(new HashMap&lt;>());&#xD;
     }&#xD;
     return departmentRepository.save(department);&#xD;
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmgYg3LIEfC-BOCJpGoLHQ" name="updateDepartment" specification="_hk2LonLIEfC-BOCJpGoLHQ">
                <ownedParameter xmi:id="_hmgYhHLIEfC-BOCJpGoLHQ" name="id">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
                <ownedParameter xmi:id="_hmgYhXLIEfC-BOCJpGoLHQ" name="department" type="_hLepYHLIEfC-BOCJpGoLHQ"/>
                <ownedParameter xmi:id="_hmgYhnLIEfC-BOCJpGoLHQ" type="_hLepYHLIEfC-BOCJpGoLHQ" direction="return"/>
                <language>java</language>
                <body>return departmentRepository.findById(id).map(dep -> {&#xD;
         dep.setName(department.getName());&#xD;
         dep.setLocation(department.getLocation());&#xD;
         dep.setContactPerson(department.getContactPerson());&#xD;
         dep.setPhone(department.getPhone());&#xD;
         dep.setEmail(department.getEmail());&#xD;
         dep.setUpdatedAt(Instant.now());&#xD;
         // Not updating equipmentInventory here for safety, use assignEquipment API&#xD;
         return departmentRepository.save(dep);&#xD;
     }).orElseThrow(() -> new NoSuchElementException(&quot;Department not found&quot;));&#xD;
 </body>
              </ownedBehavior>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_hmgYh3LIEfC-BOCJpGoLHQ" name="deleteDepartment" specification="_hMrjQHLIEfC-BOCJpGoLHQ">
