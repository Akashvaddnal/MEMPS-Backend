package com.mepms.controller;

import static org.mockito.ArgumentMatchers.any;
import static org.hamcrest.Matchers.hasSize;
import static org.hamcrest.Matchers.is;
import static org.mockito.Mockito.doNothing;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;

import java.text.SimpleDateFormat;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.Optional;

import org.bson.types.ObjectId;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.request.MockMvcRequestBuilders;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.SerializationFeature;
import com.fasterxml.jackson.datatype.jsr310.JavaTimeModule;
import com.mepms.entity.PurchaseOrder;
import com.mepms.entity.PurchaseOrderItem;
import com.mepms.repository.PurchaseOrderItemRepository;
import com.mepms.service.PurchaseOrderService;

@WebMvcTest(PurchaseOrderController.class)
public class PurchaseOrderControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @MockBean
    private PurchaseOrderService purchaseOrderService;

    @MockBean
    private PurchaseOrderItemRepository purchaseOrderItemRepository;

    private final ObjectMapper objectMapper = new ObjectMapper()
        .registerModule(new JavaTimeModule())
        .disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);

    private PurchaseOrder testOrder;
    private List<PurchaseOrder> testOrders;
    private PurchaseOrderItem testItem;

    @BeforeEach
    public void setup() throws Exception {
        SimpleDateFormat sdf = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSZ");
        
        testItem = new PurchaseOrderItem();
        testItem.setId(new ObjectId().toString());
        testItem.setEquipmentId("equip1");
        testItem.setQuantity(2);
        testItem.setUnitPrice(500.0);
        testItem.setTotal(1000.0);
        
        testOrder = new PurchaseOrder();
        testOrder.setId(new ObjectId().toString());
        testOrder.setPoNumber("PO-20230501-001");
        testOrder.setDateIssued(sdf.parse("2023-05-01T10:00:00.000+0000"));
        testOrder.setStatus("PENDING");
        testOrder.setVendorId("vendor1");
        testOrder.setRequestedBy("user1");
        testOrder.setApprovedBy("admin1");
        testOrder.setTotalAmount(1000.0);
        testOrder.setItems(Collections.singletonList(testItem));
        testOrder.setDeliveryDate(sdf.parse("2023-05-15T10:00:00.000+0000"));
        testOrder.setPaymentStatus("PENDING");
        testOrder.setPriority("HIGH");
        testOrder.setNotes("Urgent order");
        
        PurchaseOrder testOrder2 = new PurchaseOrder();
        testOrder2.setId(new ObjectId().toString());
        testOrder2.setPoNumber("PO-20230502-002");
        testOrder2.setDateIssued(sdf.parse("2023-05-02T10:00:00.000+0000"));
        testOrder2.setStatus("APPROVED");
        
        testOrders = Arrays.asList(testOrder, testOrder2);
    }

    @Test
    public void getAllPurchaseOrders_ShouldReturnAllOrders() throws Exception {
        when(purchaseOrderService.getAllPurchaseOrders()).thenReturn(testOrders);

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$", hasSize(2)))
                .andExpect(jsonPath("$[0].poNumber", is(testOrder.getPoNumber())))
                .andExpect(jsonPath("$[1].poNumber", is(testOrders.get(1).getPoNumber())));
    }

    @Test
    public void getPurchaseOrderById_ShouldReturnOrder() throws Exception {
        when(purchaseOrderService.getPurchaseOrderById(testOrder.getId())).thenReturn(Optional.of(testOrder));

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders/" + testOrder.getId())
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id", is(testOrder.getId())))
                .andExpect(jsonPath("$.poNumber", is(testOrder.getPoNumber())))
                .andExpect(jsonPath("$.status", is(testOrder.getStatus())));
    }

    @Test
    public void getPurchaseOrderById_ShouldReturnNotFound() throws Exception {
        String nonExistentId = new ObjectId().toString();
        when(purchaseOrderService.getPurchaseOrderById(nonExistentId)).thenReturn(Optional.empty());

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders/" + nonExistentId)
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk());
    }

    @Test
    public void getPurchaseOrderByPoNumber_ShouldReturnOrder() throws Exception {
        when(purchaseOrderService.getPurchaseOrderByPoNumber(testOrder.getPoNumber()))
            .thenReturn(Optional.of(testOrder));

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders/po-number/" + testOrder.getPoNumber())
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.poNumber", is(testOrder.getPoNumber())));
    }

    @Test
    public void getPurchaseOrdersByVendor_ShouldReturnVendorOrders() throws Exception {
        when(purchaseOrderService.getPurchaseOrdersByVendorId(testOrder.getVendorId()))
            .thenReturn(Collections.singletonList(testOrder));

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders/vendor/" + testOrder.getVendorId())
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$", hasSize(1)))
                .andExpect(jsonPath("$[0].vendorId", is(testOrder.getVendorId())));
    }

    @Test
    public void getPurchaseOrdersByStatus_ShouldReturnFilteredOrders() throws Exception {
        when(purchaseOrderService.getPurchaseOrdersByStatus(testOrder.getStatus()))
            .thenReturn(Collections.singletonList(testOrder));

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders/status/" + testOrder.getStatus())
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$", hasSize(1)))
                .andExpect(jsonPath("$[0].status", is(testOrder.getStatus())));
    }

    @Test
    public void createPurchaseOrder_ShouldReturnCreatedOrder() throws Exception {
        when(purchaseOrderService.createPurchaseOrder(any(PurchaseOrder.class))).thenReturn(testOrder);

        mockMvc.perform(MockMvcRequestBuilders.post("/api/purchase-orders")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(testOrder)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id", is(testOrder.getId())))
                .andExpect(jsonPath("$.poNumber", is(testOrder.getPoNumber())))
                .andExpect(jsonPath("$.items[0].id", is(testItem.getId())));
    }

    @Test
    public void updatePurchaseOrder_ShouldReturnUpdatedOrder() throws Exception {
        PurchaseOrder updatedOrder = new PurchaseOrder();
        updatedOrder.setId(testOrder.getId());
        updatedOrder.setStatus("APPROVED");
        updatedOrder.setNotes("Updated notes");
        
        when(purchaseOrderService.getPurchaseOrderById(testOrder.getId())).thenReturn(Optional.of(testOrder));
        when(purchaseOrderService.createPurchaseOrder(any(PurchaseOrder.class))).thenReturn(updatedOrder);

        mockMvc.perform(MockMvcRequestBuilders.put("/api/purchase-orders/" + testOrder.getId())
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(updatedOrder)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status", is(updatedOrder.getStatus())))
                .andExpect(jsonPath("$.notes", is(updatedOrder.getNotes())));
    }

    @Test
    public void updatePurchaseOrderStatus_ShouldReturnUpdatedOrder() throws Exception {
        PurchaseOrder statusUpdate = new PurchaseOrder();
        statusUpdate.setStatus("APPROVED");
        
        when(purchaseOrderService.getPurchaseOrderById(testOrder.getId())).thenReturn(Optional.of(testOrder));
        when(purchaseOrderService.createPurchaseOrder(any(PurchaseOrder.class))).thenAnswer(invocation -> {
            PurchaseOrder po = invocation.getArgument(0);
            testOrder.setStatus(po.getStatus());
            return testOrder;
        });

        mockMvc.perform(MockMvcRequestBuilders.put("/api/purchase-orders/purchase-orders/" + testOrder.getId())
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(statusUpdate)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.status", is("APPROVED")));
    }

    @Test
    public void deletePurchaseOrder_ShouldReturnNoContent() throws Exception {
        doNothing().when(purchaseOrderService).deletePurchaseOrder(testOrder.getId());

        mockMvc.perform(MockMvcRequestBuilders.delete("/api/purchase-orders/" + testOrder.getId())
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk());
    }

    @Test
    public void getTotalAmountByVendor_ShouldReturnCorrectAmount() throws Exception {
        Double totalAmount = 5000.0;
        when(purchaseOrderService.getTotalAmountByVendor(testOrder.getVendorId())).thenReturn(totalAmount);

        mockMvc.perform(MockMvcRequestBuilders.get("/api/purchase-orders/reports/total-amount/vendor/" + testOrder.getVendorId())
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$", is(totalAmount)));
    }
}