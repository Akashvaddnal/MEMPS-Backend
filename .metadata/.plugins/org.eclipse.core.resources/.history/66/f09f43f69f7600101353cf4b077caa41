package com.mepms.scheduler;


import com.mepms.entity.EquipmentUsage;
import com.mepms.service.EquipmentUsageService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;
import org.springframework.web.client.RestTemplate;

import java.time.Instant;
import java.util.Date;
import java.util.List;

@Component
public class EquipmentUsageMonitor {

    private static final String BASE_URL = "http://localhost:9090/Inventory-Manager-MS";

    @Autowired
    private EquipmentUsageService usageService;

    private final RestTemplate restTemplate = new RestTemplate();

    /**
     * This runs every 1 minute 
     * (cron can be adjusted e.g. "0 * * * * *" for every minute)
     */
    @Scheduled(cron = "0 */1 * * * *") 
    public void checkAndUpdateEquipmentStatus() {
        try {
            List<EquipmentUsage> allUsages = usageService.findAll();
            Instant now = Instant.now();

            for (EquipmentUsage usage : allUsages) {
                if (usage.getUsageStart() != null && usage.getUsageEnd() != null) {

                    Instant start = usage.getUsageStart().toInstant();
                    Instant end = usage.getUsageEnd().toInstant();

                    // Check START time match (Within this minute)
                    if (now.isAfter(start) && now.isBefore(end) && "Reserved".equalsIgnoreCase(usage.getStatus())) {
                        updateEquipmentUnitStatus(usage.getUnitId(), "Unavailable");
                        // Also optionally mark usage status as In Use
                    }

                    // Check END time passed
                    if (now.isAfter(end) && !"Available".equalsIgnoreCase(usage.getStatus())) {
                        updateEquipmentUnitStatus(usage.getUnitId(), "available");
                        // Mark as Released from Reserved state
                        releaseFromReserved(usage.getUnitId());
                    }
                }
            }
        } catch (Exception e) {
            System.err.println("Error during equipment usage monitoring: " + e.getMessage());
        }
    }

    private void updateEquipmentUnitStatus(String unitId, String status) {
        String url = BASE_URL + "/api/equipment-units/" + unitId + "/status?status=" + status;
        try {
            restTemplate.put(url, null);
            System.out.println("Updated EquipmentUnit " + unitId + " to status: " + status);
        } catch (Exception e) {
            System.err.println("Failed to update unit status: " + e.getMessage());
        }
    }

    private void releaseFromReserved(String unitId) {
        String url = BASE_URL + "/api/equipment-units/" + unitId + "/release";
        try {
            restTemplate.put(url, null);
            System.out.println("Released EquipmentUnit " + unitId + " from reserved.");
        } catch (Exception e) {
            System.err.println("Failed to release unit: " + e.getMessage());
        }
    }
}
