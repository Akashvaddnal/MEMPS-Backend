    @Test
    void register() throws Exception {
        when(authService.register(any(User.class)))
            .thenReturn((ResponseEntity<String>) ResponseEntity.ok("User registered successfully"));

        mockMvc.perform(post("/api/auth/register")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\",\"password\":\"password\"}"))
                .andExpect(status().isOk())
                .andExpect(content().string("User registered successfully"));

        verify(authService, times(1)).register(any(User.class));
    }
    

    @Test
    void login() throws Exception {
        when(authService.login(anyString(), anyString())).thenReturn(ResponseEntity.ok("Login successful"));

        mockMvc.perform(post("/api/auth/login")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\",\"password\":\"password\"}"))
                .andExpect(status().isOk())
                .andExpect(content().string("Login successful"));

        verify(authService, times(1)).login("test@example.com", "password");
    }

    @Test
    void getCurrentUser() throws Exception {
        when(jwtUtil.extractEmail(anyString())).thenReturn("test@example.com");
        when(authService.findByEmail(anyString())).thenReturn(user);

        mockMvc.perform(get("/api/auth/current")
                .header("Authorization", "Bearer token"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.email").value("test@example.com"))
                .andExpect(jsonPath("$.password").doesNotExist());

        verify(jwtUtil, times(1)).extractEmail("token");
        verify(authService, times(1)).findByEmail("test@example.com");
    }

    @Test
    void getCurrentUserNotFound() throws Exception {
        when(jwtUtil.extractEmail(anyString())).thenReturn("test@example.com");
        when(authService.findByEmail(anyString())).thenReturn(null);

        mockMvc.perform(get("/api/auth/current")
                .header("Authorization", "Bearer token"))
                .andExpect(status().isNotFound());

        verify(jwtUtil, times(1)).extractEmail("token");
        verify(authService, times(1)).findByEmail("test@example.com");
    }

    @Test
    void forgotPasswordInitiate() throws Exception {
        when(userRepo.findByEmail(anyString())).thenReturn(user);
        doNothing().when(emailService).sendOtp(anyString(), anyString());

        mockMvc.perform(post("/api/auth/forgot-password-initiate")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\"}"))
                .andExpect(status().isOk())
                .andExpect(content().string("OTP sent to your email"));

        verify(userRepo, times(1)).findByEmail("test@example.com");
        verify(emailService, times(1)).sendOtp("test@example.com", anyString());
    }

    @Test
    void forgotPasswordInitiateEmailNotFound() throws Exception {
        when(userRepo.findByEmail(anyString())).thenReturn(null);

        mockMvc.perform(post("/api/auth/forgot-password-initiate")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\"}"))
                .andExpect(status().isNotFound())
                .andExpect(content().string("Email not registered."));

        verify(userRepo, times(1)).findByEmail("test@example.com");
    }

    @Test
    void verifyOtp() throws Exception {
        user.setResetPasswordOtp("123456");
        user.setResetPasswordOtpExpiry(new Date(System.currentTimeMillis() + 15*60*1000));
        when(userRepo.findByEmail(anyString())).thenReturn(user);

        mockMvc.perform(post("/api/auth/forgot-password-verify")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\",\"otp\":\"123456\"}"))
                .andExpect(status().isOk())
                .andExpect(content().string("OTP valid"));

        verify(userRepo, times(1)).findByEmail("test@example.com");
    }

    @Test
    void verifyOtpInvalid() throws Exception {
        user.setResetPasswordOtp("123456");
        user.setResetPasswordOtpExpiry(new Date(System.currentTimeMillis() - 1000)); // Expired
        when(userRepo.findByEmail(anyString())).thenReturn(user);

        mockMvc.perform(post("/api/auth/forgot-password-verify")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\",\"otp\":\"123456\"}"))
                .andExpect(status().isBadRequest())
                .andExpect(content().string("Invalid or expired OTP"));

        verify(userRepo, times(1)).findByEmail("test@example.com");
    }

    @Test
    void resetPassword() throws Exception {
        user.setResetPasswordOtp("123456");
        user.setResetPasswordOtpExpiry(new Date(System.currentTimeMillis() + 15*60*1000));
        when(userRepo.findByEmail(anyString())).thenReturn(user);
        when(passwordEncoder.encode(anyString())).thenReturn("encodedPassword");

        mockMvc.perform(post("/api/auth/reset-password")
                .contentType(MediaType.APPLICATION_JSON)
                .content("{\"email\":\"test@example.com\",\"newPassword\":\"newPass\",\"otp\":\"123456\"}"))
                .andExpect(status().isOk())
                .andExpect(content().string("Password reset successful"));

        verify(userRepo, times(1)).findByEmail("test@example.com");
        verify(userRepo, times(1)).save(user);
    }
