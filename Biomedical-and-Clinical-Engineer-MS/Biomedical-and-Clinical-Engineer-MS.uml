              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJlqMHLHEfC-BOCJpGoLHQ" name="getById" specification="_yaOCwHLHEfC-BOCJpGoLHQ">
                <ownedParameter xmi:id="_zJlqMXLHEfC-BOCJpGoLHQ" name="id">
                  <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
                </ownedParameter>
                <ownedParameter xmi:id="_zJlqMnLHEfC-BOCJpGoLHQ" type="_zCRhQHLHEfC-BOCJpGoLHQ" direction="return"/>
