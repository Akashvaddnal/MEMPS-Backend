              <interfaceRealization xmi:id="_zEGGMHLHEfC-BOCJpGoLHQ" client="_yaFf4HLHEfC-BOCJpGoLHQ" supplier="_yYztgHLHEfC-BOCJpGoLHQ" contract="_yYztgHLHEfC-BOCJpGoLHQ"/>
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJkcEHLHEfC-BOCJpGoLHQ" name="DepartmentServiceImpl" specification="_zEIicHLHEfC-BOCJpGoLHQ">
                <ownedParameter xmi:id="_zJkcEXLHEfC-BOCJpGoLHQ" name="departmentRepository" type="_yX5HgHLHEfC-BOCJpGoLHQ"/>
