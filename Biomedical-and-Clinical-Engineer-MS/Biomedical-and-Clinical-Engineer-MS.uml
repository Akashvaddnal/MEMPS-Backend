              <ownedAttribute xmi:id="_zINKIHLHEfC-BOCJpGoLHQ" name="equipmentRepository" visibility="private" isLeaf="true" type="_yYN3oHLHEfC-BOCJpGoLHQ" isReadOnly="true" association="_zLZBAHLHEfC-BOCJpGoLHQ"/>
