            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJMBkHLHEfC-BOCJpGoLHQ" name="customConversions" specification="_yTfvsXLHEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_zJMBkXLHEfC-BOCJpGoLHQ" type="_zBSCwXLHEfC-BOCJpGoLHQ" direction="return"/>
              <language>java</language>
              <body>Converter&lt;String, LocalDateTime> stringToLocalDateTime = new Converter&lt;String, LocalDateTime>() {&#xD;
         @Override&#xD;
         public LocalDateTime convert(String source) {&#xD;
             if (source == null || source.isEmpty()) {&#xD;
                 return null;&#xD;
             }&#xD;
             return LocalDateTime.parse(source);&#xD;
         }&#xD;
     };&#xD;
     &#xD;
     return new MongoCustomConversions(Arrays.asList(stringToLocalDateTime));&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJMooHLHEfC-BOCJpGoLHQ" name="validator" specification="_yTjaEHLHEfC-BOCJpGoLHQ">
