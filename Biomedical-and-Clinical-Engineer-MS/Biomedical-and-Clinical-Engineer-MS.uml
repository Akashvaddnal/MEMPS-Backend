          <packagedElement xmi:type="uml:Class" xmi:id="_ycfToHLHEfC-BOCJpGoLHQ" name="DepartmentControllerTest" visibility="package">
            <eAnnotations xmi:id="_ycf6sHLHEfC-BOCJpGoLHQ" source="http://ns.yatta.de/umllab">
              <contents xmi:type="ecore:EAnnotation" xmi:id="_ycf6sXLHEfC-BOCJpGoLHQ" source="codegen">
                <details xmi:id="_ycf6snLHEfC-BOCJpGoLHQ" key="codegenDirectory" value="/Biomedical-and-Clinical-Engineer-MS/src/test/java"/>
              </contents>
            </eAnnotations>
            <ownedAttribute xmi:id="_zIT30HLHEfC-BOCJpGoLHQ" name="mockMvc" visibility="private" type="_zFLrUXLHEfC-BOCJpGoLHQ" association="_zLbdQXLHEfC-BOCJpGoLHQ"/>
            <ownedAttribute xmi:id="_zIVF8HLHEfC-BOCJpGoLHQ" name="departmentService" visibility="private" type="_yYztgHLHEfC-BOCJpGoLHQ" association="_zLbdRHLHEfC-BOCJpGoLHQ"/>
            <ownedAttribute xmi:id="_zIWUEXLHEfC-BOCJpGoLHQ" name="departmentController" visibility="private" type="_yTvAQHLHEfC-BOCJpGoLHQ" association="_zLcEUXLHEfC-BOCJpGoLHQ"/>
            <ownedAttribute xmi:id="_zIXiMHLHEfC-BOCJpGoLHQ" name="department" visibility="private" type="_yXCL4HLHEfC-BOCJpGoLHQ" association="_zLcrYXLHEfC-BOCJpGoLHQ"/>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCQHLHEfC-BOCJpGoLHQ" name="setUp" specification="_ychv4HLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>MockitoAnnotations.openMocks(this);&#xD;
     mockMvc = MockMvcBuilders.standaloneSetup(departmentController).build();&#xD;
&#xD;
     department = new Department();&#xD;
     department.setId(&quot;1&quot;);&#xD;
     department.setName(&quot;Cardiology&quot;);&#xD;
     department.setLocation(&quot;Floor 1&quot;);&#xD;
     department.setEquipmentInventory(new HashMap&lt;>());&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCQXLHEfC-BOCJpGoLHQ" name="getAllDepartments" specification="_yckMIXLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>List&lt;Department> departments = Arrays.asList(department);&#xD;
     when(departmentService.searchDepartments(anyString(), anyString())).thenReturn(departments);&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/departments&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$[0].name&quot;).value(&quot;Cardiology&quot;));&#xD;
&#xD;
     verify(departmentService, times(1)).searchDepartments(null, null);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCQnLHEfC-BOCJpGoLHQ" name="getDepartmentById" specification="_ycmBUHLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(departmentService.getById(&quot;1&quot;)).thenReturn(java.util.Optional.of(department));&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/departments/1&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$.name&quot;).value(&quot;Cardiology&quot;));&#xD;
&#xD;
     verify(departmentService, times(1)).getById(&quot;1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCQ3LHEfC-BOCJpGoLHQ" name="getDepartmentByIdNotFound" specification="_ycn2gXLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(departmentService.getById(&quot;1&quot;)).thenReturn(java.util.Optional.empty());&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/departments/1&quot;))&#xD;
             .andExpect(status().isNotFound());&#xD;
&#xD;
     verify(departmentService, times(1)).getById(&quot;1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCRHLHEfC-BOCJpGoLHQ" name="createDepartment" specification="_ycq50HLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(departmentService.createDepartment(any(Department.class))).thenReturn(department);&#xD;
&#xD;
     mockMvc.perform(post(&quot;/api/departments&quot;)&#xD;
                     .contentType(MediaType.APPLICATION_JSON)&#xD;
                     .content(&quot;{\&quot;name\&quot;:\&quot;Cardiology\&quot;,\&quot;location\&quot;:\&quot;Floor 1\&quot;}&quot;))&#xD;
             .andExpect(status().isCreated())&#xD;
             .andExpect(jsonPath(&quot;$.name&quot;).value(&quot;Cardiology&quot;));&#xD;
&#xD;
     verify(departmentService, times(1)).createDepartment(any(Department.class));&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCRXLHEfC-BOCJpGoLHQ" name="updateDepartment" specification="_yctWEHLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(departmentService.updateDepartment(anyString(), any(Department.class))).thenReturn(department);&#xD;
&#xD;
     mockMvc.perform(put(&quot;/api/departments/1&quot;)&#xD;
                     .contentType(MediaType.APPLICATION_JSON)&#xD;
                     .content(&quot;{\&quot;name\&quot;:\&quot;Cardiology\&quot;,\&quot;location\&quot;:\&quot;Floor 1\&quot;}&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$.name&quot;).value(&quot;Cardiology&quot;));&#xD;
&#xD;
     verify(departmentService, times(1)).updateDepartment(eq(&quot;1&quot;), any(Department.class));&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwCRnLHEfC-BOCJpGoLHQ" name="deleteDepartment" specification="_ycwZYHLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>doNothing().when(departmentService).deleteDepartment(&quot;1&quot;);&#xD;
&#xD;
     mockMvc.perform(delete(&quot;/api/departments/1&quot;))&#xD;
             .andExpect(status().isNoContent());&#xD;
&#xD;
     verify(departmentService, times(1)).deleteDepartment(&quot;1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwpUHLHEfC-BOCJpGoLHQ" name="assignEquipmentToDepartment" specification="_ycy1oHLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>Map&lt;String, Integer> inventory = new HashMap&lt;>();&#xD;
     inventory.put(&quot;equip1&quot;, 1);&#xD;
     department.setEquipmentInventory(inventory);&#xD;
&#xD;
     when(departmentService.assignEquipmentToDepartment(anyString(), anyString())).thenReturn(department);&#xD;
&#xD;
     mockMvc.perform(post(&quot;/api/departments/1/assign-equipment/equip1&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$.equipmentInventory.equip1&quot;).value(1));&#xD;
&#xD;
     verify(departmentService, times(1)).assignEquipmentToDepartment(&quot;1&quot;, &quot;equip1&quot;);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_zJwpUXLHEfC-BOCJpGoLHQ" name="getEquipmentsByDepartment" specification="_yc148HLHEfC-BOCJpGoLHQ">
              <language>java</language>
              <body>when(departmentService.getEquipmentsByDepartmentName(&quot;Cardiology&quot;)).thenReturn(Arrays.asList(new Equipment()));&#xD;
&#xD;
     mockMvc.perform(get(&quot;/api/departments/equipment/department/Cardiology&quot;))&#xD;
             .andExpect(status().isOk())&#xD;
             .andExpect(jsonPath(&quot;$&quot;).isArray());&#xD;
&#xD;
     verify(departmentService, times(1)).getEquipmentsByDepartmentName(&quot;Cardiology&quot;);&#xD;
 </body>
            </ownedBehavior>
