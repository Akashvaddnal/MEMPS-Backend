            <ownedAttribute xmi:id="_ATylY3VfEfC-BOCJpGoLHQ" name="userRepo" visibility="private" type="_ARVHR3VfEfC-BOCJpGoLHQ" association="_AUMOAXVfEfC-BOCJpGoLHQ"/>
            <ownedAttribute xmi:id="_ATylZnVfEfC-BOCJpGoLHQ" name="emailService" visibility="private" type="_ARdDEHVfEfC-BOCJpGoLHQ" association="_AUMOBHVfEfC-BOCJpGoLHQ"/>
