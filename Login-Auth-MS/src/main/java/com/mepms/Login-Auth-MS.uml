          <packagedElement xmi:type="uml:Class" xmi:id="_ARWVYHVfEfC-BOCJpGoLHQ" name="AuthServiceImpl">
            <ownedAttribute xmi:id="_AT3d4nVfEfC-BOCJpGoLHQ" name="userRepository" visibility="private" type="_ARVHR3VfEfC-BOCJpGoLHQ" association="_AUM1GnVfEfC-BOCJpGoLHQ"/>
