            </ownedAttribute>
            <ownedAttribute xmi:id="_AT5TFXVfEfC-BOCJpGoLHQ" name="SECRET_KEY" visibility="private" isLeaf="true" type="_ATo0ZnVfEfC-BOCJpGoLHQ" isReadOnly="true" association="_AUOqQ3VfEfC-BOCJpGoLHQ">
              <defaultValue xmi:type="uml:LiteralString" xmi:id="_AT5TFnVfEfC-BOCJpGoLHQ" value="Keys.hmacShaKeyFor(SECRET_KEY_STRING.getBytes(StandardCharsets.UTF_8))"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_AT5TF3VfEfC-BOCJpGoLHQ" name="EXPIRATION_TIME" visibility="private" isLeaf="true" isReadOnly="true">
              <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#long"/>
              <defaultValue xmi:type="uml:LiteralString" xmi:id="_AT5TGHVfEfC-BOCJpGoLHQ" value="86400000"/>
            </ownedAttribute>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_AT9kk3VfEfC-BOCJpGoLHQ" name="generateToken" specification="_ATpbcHVfEfC-BOCJpGoLHQ">
              <ownedParameter xmi:id="_AT9klHVfEfC-BOCJpGoLHQ" name="user" type="_ARTSEHVfEfC-BOCJpGoLHQ"/>
              <ownedParameter xmi:id="_AT9klXVfEfC-BOCJpGoLHQ" direction="return">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <language>java</language>
              <body>return Jwts.builder()
             .setSubject(user.getEmail())
             .claim(&quot;roleName&quot;, user.getRoleName())
             .setIssuedAt(new Date())
             .setExpiration(new Date(System.currentTimeMillis() + EXPIRATION_TIME))
             .signWith(SECRET_KEY, SignatureAlgorithm.HS512)
             .compact();
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_AT9klnVfEfC-BOCJpGoLHQ" name="extractEmail" specification="_AReRMXVfEfC-BOCJpGoLHQ">
